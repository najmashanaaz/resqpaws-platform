# ---- Server ----
PORT=5000
NODE_ENV=development
# Local MongoDB, or paste your MongoDB Atlas connection string here
MONGODB_URI=mongodb://127.0.0.1:27017/resqpaws
# Change this to a long random text before going live
JWT_SECRET=change-me-to-a-long-random-secret
# Address of the website (for CORS). Use your real domain in production.
CLIENT_ORIGIN=http://localhost:5173

# ---- Audio AI ----
# Animal must score at least this (0 to 1) or we say "Animal Not Recognized"
CONFIDENCE_THRESHOLD=0.35
MAX_UPLOAD_MB=10

# ---- Demo accounts created by "npm run seed" ----
ADMIN_EMAIL=admin@resqpaws.demo
ADMIN_PASSWORD=Admin@12345
DEMO_USER_EMAIL=user@resqpaws.demo
DEMO_USER_PASSWORD=User@12345

# ---- Optional integrations ----
# Gemini chatbot (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Emergency alerts: any URL that accepts a JSON POST (Slack/Discord/Teams webhook, Zapier, etc.)
ALERT_WEBHOOK_URL=
