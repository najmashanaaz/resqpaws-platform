# Where the API lives. "/api" works with the dev proxy and with the single-service deployment.
VITE_API_URL=/api
# Location of the AI model files (created by "npm run setup:model")
VITE_YAMNET_URL=/models/yamnet/model.json
# Optional: Mapbox token for Mapbox tiles. Leave empty to use free OpenStreetMap tiles.
VITE_MAPBOX_TOKEN=
